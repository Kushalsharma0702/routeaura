# Copy to .env (never commit .env). Values below are placeholders for LOCAL DEVELOPMENT only.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://localhost:5432/routeaura
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
CORS_ORIGINS=http://localhost:8080
# Development seed accounts (used only when ENVIRONMENT=development)
SEED_ADMIN_EMAIL=admin@routeaura.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_TRAVELER_EMAIL=client@routeaura.com
SEED_TRAVELER_PASSWORD=Client@123

# Optional providers. Leave unset to use the deterministic fallbacks (clearly labelled in the UI).
# LLM_PROVIDER=anthropic          # none | anthropic
# LLM_API_KEY=
# LLM_MODEL=claude-sonnet-5-5
# ROUTING_PROVIDER=osrm           # none | osrm (self-hosted OSRM recommended)
# OSRM_BASE_URL=http://localhost:5000
# WEATHER_PROVIDER=open-meteo     # none | open-meteo (free, non-commercial; sends destination coordinates only)
# WEATHER_MAX_AGE_MINUTES=180
